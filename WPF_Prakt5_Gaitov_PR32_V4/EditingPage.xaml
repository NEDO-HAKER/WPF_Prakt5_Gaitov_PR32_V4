<Page x:Class="WPF_Prakt5_Gaitov_PR32_V4.EditingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_Prakt5_Gaitov_PR32_V4"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditingPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Label Content="ID"/>
            <Label Content="Дата"/>
            <Label Content="Номер кассы"/>
            <Label Content="Кассир"/>
            <Label Content="Итоговая сумма (руб.)" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBox Margin="5" Text="{Binding Receipt.Id}"/>
            <TextBox Margin="5" Text="{Binding Receipt.Date}"/>
            <TextBox Margin="5" Text="{Binding Receipt.CashDeskNumber}"/>
            <TextBox Margin="5" Text="{Binding Receipt.Cashier}"/>
            <TextBox Margin="5" Text="{Binding Receipt.ReceiptTotal}" IsReadOnly="True"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,15,0,0">
            <TextBlock Text="Товары в этом чеке:" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

            <ListView ItemsSource="{Binding Receipt.Items}" SelectedItem="{Binding SelectedItem}" Height="200" BorderBrush="Gray" BorderThickness="1">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                <TextBlock Text=" | "/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Column="1">
                                <TextBlock Text="{Binding Price}" VerticalAlignment="Center"/>
                                <TextBlock Text="руб. за шт. | "/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Column="2">
                                <TextBlock Text="{Binding Count}" VerticalAlignment="Center"/>
                                <TextBlock Text="шт. | " />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Column="3">
                                <TextBlock FontWeight="Bold" Text="{Binding ItemTotal}" VerticalAlignment="Center"/>
                                <TextBlock FontWeight="Bold" Text="руб."/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Button Content="Добавить товар" Click="AddItem_Click" Margin="0,0,10,0" Padding="10,5"/>
                <Button Content="Удалить товар" Click="RemoveItem_Click" Padding="10,5"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,15,5,5">
            <Button Content="Сохранить" Click="AddButton_Click" Margin="0,0,10,0" Padding="15,5" Height="50"/>
            <Button Content="Назад" Click="BackButton_Click" Padding="15,5" Height="50"/>
        </StackPanel>
    </Grid>
    
</Page>
