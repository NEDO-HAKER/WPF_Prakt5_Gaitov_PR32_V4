<Page x:Class="WPF_Prakt5_Gaitov_PR32_V4.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_Prakt5_Gaitov_PR32_V4"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Title="ListPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Column="0">
            <Button Click="AddButton_Click" Margin="5" Padding="5">Добавить</Button>
            <Button Click="DeleteItem_Click" Margin="5" Padding="5">Удалить</Button>
            <Button Click="SaveItems_CLick" Margin="5" Padding="5">Сохранить</Button>
        </StackPanel>
        <ListView Grid.Column="0"  Grid.Row="1" ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceipt}" MouseDoubleClick="EditItem_Click">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Идентификатор: "/>
                            <TextBlock Text="{Binding Id}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Дата: "/>
                            <TextBlock Text="{Binding Date}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Номер кассы: "/>
                            <TextBlock Text="{Binding CashDeskNumber}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Кассир: "/>
                            <TextBlock Text="{Binding Cashier}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Итоговая сумма чека: "/>
                            <TextBlock Text="{Binding ReceiptTotal}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <ListView Grid.Column="0"  Grid.Row="1" ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceipt}" MouseDoubleClick="EditItem_Click">
    <ListView.ItemTemplate>
        <DataTemplate>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Идентификатор: "/>
                    <TextBlock Text="{Binding Id}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Дата: "/>
                    <TextBlock Text="{Binding Date}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Номер кассы: "/>
                    <TextBlock Text="{Binding CashDeskNumber}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Кассир: "/>
                    <TextBlock Text="{Binding Cashier}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Итоговая сумма чека: "/>
                    <TextBlock Text="{Binding ReceiptTotal}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </ListView.ItemTemplate>
</ListView>
        <ListView Grid.Column="1"  Grid.Row="1" ItemsSource="{Binding SelectedReceipt.Items}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            <TextBlock Text=" | "/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="1">
                            <TextBlock Text="{Binding Price}" VerticalAlignment="Center"/>
                            <TextBlock Text="руб. за шт. | "/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="2">
                            <TextBlock Text="{Binding Count}" VerticalAlignment="Center"/>
                            <TextBlock Text="шт. | " />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="3">
                            <TextBlock FontWeight="Bold" Text="{Binding ItemTotal}" VerticalAlignment="Center"/>
                            <TextBlock FontWeight="Bold" Text="руб."/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="2" Background="AntiqueWhite">
            <Label>Всего в списке:</Label>
            <Label Content="{Binding Receipts.Count}"/>
        </StackPanel>
    </Grid>
</Page>